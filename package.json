{
  "name": "azion",
  "version": "0.0.1",
  "description": "Azion Packages for Edge Computing.",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "compile": "pnpm -r --if-present compile",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "format": "pnpm -r --if-present prettier",
    "format:check": "pnpm -r --if-present prettier:check",
    "test": "pnpm -r --if-present --workspace-concurrency=1 test",
    "test:e2e": "npx jest ./tests/e2e/*",
    "download:cli": "node ./cli/scripts/download-cli.mjs",
    "build": "pnpm -r --if-present compile"
  },
  "keywords": [
    "azion",
    "edge",
    "computing",
    "packages"
  ],
  "author": "aziontech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aziontech/lib.git"
  },
  "contributors": [
    {
      "name": "José Filho",
      "url": "https://github.com/jcsbfilho"
    },
    {
      "name": "Magnun A V F",
      "url": "https://github.com/MagnunAVFAzion"
    },
    {
      "name": "João Narciso",
      "url": "https://jotanarciso.com"
    }
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "pkg-pr-new": "^0.0.93",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-gcqx-w48m-w2h4"
      ]
    },
    "overrides": {
      "lodash": ">=4.18.0",
      "postcss": ">=8.5.18",
      "fast-uri": ">=4.2.3",
      "qs": ">=6.16.1",
      "esbuild": ">=0.28.1",
      "source-map-js": ">=1.2.2",
      "brace-expansion@1": "^1.1.17",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "js-yaml@3": "^3.15.0",
      "js-yaml@4": "^4.2.0",
      "js-yaml@3>argparse": "^2.0.1",
      "@rushstack/ts-command-line>argparse": "^2.0.1",
      "@babel/core": ">=7.29.6",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "handlebars": ">=4.7.10",
      "vite@7": "^7.3.7",
      "minimatch@<11.0.1": ">=11.0.1",
      "glob@<14.0.2": ">=14.0.2"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "README.md",
    "package.json",
    "packages/**/dist/**/*",
    "cli/**/*",
    "packages/unenv-preset/src/polyfills/*",
    "packages/builder/src/polyfills/*",
    "packages/presets/src/presets/next/*",
    "packages/presets/src/presets/nuxt/nitro/*",
    "packages/presets/src/presets/svelte/kit/*"
  ]
}
