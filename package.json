{
  "name": "azion",
  "version": "0.0.1",
  "description": "Azion Packages for Edge Computing.",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "compile": "pnpm -r --if-present compile",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "format": "pnpm -r --if-present prettier",
    "format:check": "pnpm -r --if-present prettier:check",
    "test": "pnpm -r --if-present --workspace-concurrency=1 test",
    "test:e2e": "npx jest ./tests/e2e/*",
    "download:cli": "node ./cli/scripts/download-cli.mjs",
    "build": "pnpm -r --if-present compile"
  },
  "keywords": [
    "azion",
    "edge",
    "computing",
    "packages"
  ],
  "author": "aziontech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aziontech/lib.git"
  },
  "contributors": [
    {
      "name": "José Filho",
      "url": "https://github.com/jcsbfilho"
    },
    {
      "name": "Magnun A V F",
      "url": "https://github.com/MagnunAVFAzion"
    },
    {
      "name": "João Narciso",
      "url": "https://jotanarciso.com"
    }
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.29.2",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "pkg-pr-new": "^0.0.75",
    "prettier": "^3.6.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.4"
  },
  "pnpm": {
    "overrides": {
      "lodash": ">=4.18.0",
      "postcss": ">=8.5.18",
      "fast-uri": ">=4.1.1",
      "qs": ">=6.15.2",
      "esbuild": ">=0.28.1",
      "brace-expansion@1": ">=1.1.17",
      "brace-expansion@2": ">=2.1.3",
      "js-yaml@3": "^3.15.0",
      "js-yaml@4": "^4.2.0",
      "@babel/core": ">=7.29.6",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "README.md",
    "package.json",
    "packages/**/dist/**/*",
    "cli/**/*",
    "packages/unenv-preset/src/polyfills/*",
    "packages/builder/src/polyfills/*",
    "packages/presets/src/presets/next/*",
    "packages/presets/src/presets/nuxt/nitro/*",
    "packages/presets/src/presets/svelte/kit/*"
  ]
}
