{
  "build": {
    "entry": "index.js",
    "bundler": "webpack",
    "polyfills": false
  },
  "functions": [
    {
      "name": "my-emscripten-function",
      "target": "./functions/index.js",
      "args": {}
    }
  ],
  "rules": [
    {
      "name": "Execute Edge Function",
      "phase": "request",
      "description": "",
      "is_active": true,
      "order": 2,
      "criteria": [
        [
          {
            "variable": "${uri}",
            "operator": "matches",
            "conditional": "if",
            "input_value": "^\\/"
          }
        ]
      ],
      "behaviors": [
        {
          "name": "run_function",
          "target": "my-emscripten-function"
        }
      ]
    }
  ]
}
