{
  "build": {
    "entry": "index.js",
    "preset": "rustwasm",
    "polyfills": false
  },
  "origin": [
    {
      "name": "origin-storage-default",
      "type": "object_storage"
    }
  ],
  "functions": [
    {
      "name": "my-rustwasm-function",
      "path": "./functions/index.js"
    }
  ],
  "rules": {
    "request": [
      {
        "name": "Execute Edge F nction",
        "match": "^\\/",
        "behavior": {
          "runFunction": "my-rustwasm-function"
        }
      }
    ]
  }
}
