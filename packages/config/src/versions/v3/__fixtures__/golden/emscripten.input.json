{
  "build": {
    "entry": "index.js",
    "bundler": "webpack",
    "polyfills": false
  },
  "functions": [
    {
      "name": "my-emscripten-function",
      "path": "./functions/index.js"
    }
  ],
  "rules": {
    "request": [
      {
        "name": "Execute Edge Function",
        "match": "^\\/",
        "behavior": {
          "runFunction": "my-emscripten-function"
        }
      }
    ]
  }
}
