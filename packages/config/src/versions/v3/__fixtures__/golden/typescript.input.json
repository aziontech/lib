{
  "build": {
    "entry": "index.ts",
    "preset": "typescript",
    "polyfills": true
  },
  "functions": [
    {
      "name": "my-typescript-function",
      "path": "./functions/index.js"
    }
  ],
  "rules": {
    "request": [
      {
        "name": "Execute Edge Function",
        "match": "^\\/",
        "behavior": {
          "runFunction": "my-typescript-function"
        }
      }
    ]
  }
}
