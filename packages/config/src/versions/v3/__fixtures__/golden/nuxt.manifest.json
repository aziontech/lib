{
  "build": {
    "bundler": "esbuild",
    "preset": "nuxt"
  },
  "origin": [
    {
      "name": "origin-storage-default",
      "origin_type": "object_storage",
      "prefix": ""
    }
  ],
  "functions": [
    {
      "name": "handler",
      "target": "./functions/handler.js",
      "args": {}
    }
  ],
  "rules": [
    {
      "name": "Nuxt Static Assets",
      "phase": "request",
      "description": "",
      "is_active": true,
      "order": 2,
      "criteria": [
        [
          {
            "variable": "${uri}",
            "operator": "matches",
            "conditional": "if",
            "input_value": "^\\/_nuxt\\/"
          }
        ]
      ],
      "behaviors": [
        {
          "name": "set_origin",
          "target": "origin-storage-default"
        },
        {
          "name": "deliver",
          "target": null
        }
      ]
    },
    {
      "name": "Redirect to index.html for Subpaths",
      "phase": "request",
      "description": "",
      "is_active": true,
      "order": 3,
      "criteria": [
        [
          {
            "variable": "${uri}",
            "operator": "matches",
            "conditional": "if",
            "input_value": "^(?!.*/$)(?![sS]*.[a-zA-Z0-9]+$).*"
          }
        ]
      ],
      "behaviors": [
        {
          "name": "rewrite_request",
          "target": "${uri}/index.html"
        }
      ]
    },
    {
      "name": "Redirect to index.html",
      "phase": "request",
      "description": "",
      "is_active": true,
      "order": 4,
      "criteria": [
        [
          {
            "variable": "${uri}",
            "operator": "matches",
            "conditional": "if",
            "input_value": ".*/$"
          }
        ]
      ],
      "behaviors": [
        {
          "name": "rewrite_request",
          "target": "${uri}index.html"
        }
      ]
    },
    {
      "name": "Execute Nuxt Function when starts with /api/_content",
      "phase": "request",
      "description": "Handle @nuxt/content API requests - executes Nuxt function for content management endpoints. Remove this rule if your project does not use the @nuxt/content library.",
      "is_active": true,
      "order": 5,
      "criteria": [
        [
          {
            "variable": "${uri}",
            "operator": "starts_with",
            "conditional": "if",
            "input_value": "/api/_content"
          }
        ]
      ],
      "behaviors": [
        {
          "name": "run_function",
          "target": "handler"
        },
        {
          "name": "forward_cookies",
          "target": null
        },
        {
          "name": "deliver",
          "target": null
        }
      ]
    },
    {
      "name": "Deliver Static Assets",
      "phase": "request",
      "description": "",
      "is_active": true,
      "order": 6,
      "criteria": [
        [
          {
            "variable": "${uri}",
            "operator": "matches",
            "conditional": "if",
            "input_value": ".(jpg|jpeg|png|gif|bmp|webp|svg|ico|ttf|otf|woff|woff2|eot|pdf|doc|docx|xls|xlsx|ppt|pptx|mp4|webm|mp3|wav|ogg|css|js|json|xml|html|txt|csv|zip|rar|7z|tar|gz|webmanifest|map|md|yaml|yml)$"
          }
        ]
      ],
      "behaviors": [
        {
          "name": "set_origin",
          "target": "origin-storage-default"
        },
        {
          "name": "deliver",
          "target": null
        }
      ]
    },
    {
      "name": "Execute Edge Function",
      "phase": "request",
      "description": "",
      "is_active": true,
      "order": 7,
      "criteria": [
        [
          {
            "variable": "${uri}",
            "operator": "matches",
            "conditional": "if",
            "input_value": "^/"
          }
        ]
      ],
      "behaviors": [
        {
          "name": "run_function",
          "target": "handler"
        },
        {
          "name": "forward_cookies",
          "target": null
        }
      ]
    }
  ]
}
